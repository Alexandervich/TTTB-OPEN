{
  "name": "tttb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "bootstrap": "^5.3.8",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.tttb.app",
    "productName": "Tod und Teufel Toolbox",
    "files": [
      "electron/**",
      "server/**/*.js",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "../tttb-release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
